# Configuração do Truco Online para o Docker Compose.
# Copie este arquivo para .env (cp .env.example .env) e troque os valores de exemplo.
# O .env não vai para o repositório: ele guarda segredos.

# Porta do computador em que o gateway (Nginx) atende. Com 80, o endereço é http://localhost.
# Se a 80 já estiver em uso, troque por outra, por exemplo 8080 (http://localhost:8080).
GATEWAY_PORTA=80

# Segredo que assina os tokens de login (JWT). Todos os serviços usam o mesmo valor:
# o Auth assina, e os outros conferem o token sozinhos, sem chamar o Auth.
# Mínimo de 32 caracteres. Para gerar um valor bom:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SEGREDO=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# Banco do serviço Auth (container auth-db). Só o Auth conecta nele.
# Os valores valem na primeira vez que o banco sobe; para trocá-los depois, é preciso apagar o
# volume do banco (docker compose down -v), o que apaga também os usuários cadastrados.
AUTH_DB_NOME=auth
AUTH_DB_USUARIO=auth
AUTH_DB_SENHA=troque-esta-senha
