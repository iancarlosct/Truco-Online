# Configuração do Truco Online para o Docker Compose.
# Copie este arquivo para .env (cp .env.example .env) e troque os valores de exemplo.
# O .env não vai para o repositório: ele guarda segredos.

# Porta do computador em que o gateway (Nginx) atende. Com 80, o endereço é http://localhost.
# Se a 80 já estiver em uso, troque por outra, por exemplo 8080 (http://localhost:8080).
GATEWAY_PORTA=80

# Segredo que assina os tokens de login (JWT). Todos os serviços usam o mesmo valor:
# o Auth assina, e os outros conferem o token sozinhos, sem chamar o Auth.
# Mínimo de 32 caracteres. Para gerar um valor bom:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SEGREDO=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# Banco do serviço Auth (container auth-db). Só o Auth conecta nele.
# Os valores valem na primeira vez que o banco sobe; para trocá-los depois, é preciso apagar o
# volume do banco (docker compose down -v), o que apaga também os usuários cadastrados.
AUTH_DB_NOME=auth
AUTH_DB_USUARIO=auth
AUTH_DB_SENHA=troque-esta-senha

# Banco do serviço Game (container game-redis, um Redis): o estado das partidas. Só o Game
# conecta nele. A senha vale desde a primeira vez que o container sobe.
GAME_REDIS_SENHA=troque-esta-senha-do-game-redis

# Broker de eventos (container eventos, outro Redis): o meio de comunicação entre os serviços,
# com Redis Streams. O Game, o Lobby e o Ranking conectam nele com esta mesma senha; na fase 4,
# os Bots também.
EVENTOS_SENHA=troque-esta-senha-dos-eventos

# Banco do serviço Lobby (container lobby-db): as salas. Só o Lobby conecta nele.
# Como no Auth, os valores valem na primeira vez que o banco sobe; para trocá-los depois, é
# preciso apagar o volume (docker compose down -v), o que apaga também as salas.
LOBBY_DB_NOME=lobby
LOBBY_DB_USUARIO=lobby
LOBBY_DB_SENHA=troque-esta-senha-do-lobby

# Banco do serviço Ranking (container ranking-db): as partidas registradas e as vitórias de cada
# jogador. Só o Ranking conecta nele. Mesma regra: trocar depois pede docker compose down -v.
RANKING_DB_NOME=ranking
RANKING_DB_USUARIO=ranking
RANKING_DB_SENHA=troque-esta-senha-do-ranking
